{
  "name": "@boffmedia/battle-core",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/cjs/index.js",
  "types": "./dist/cjs/index.d.ts",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "type-check": "tsc --noEmit --skipLibCheck",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && node write-pkg-type.mjs",
    "prepare": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.esm.json && node write-pkg-type.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@pkmn/data": "^0.10.7",
    "@pkmn/dex": "^0.9.38",
    "@pkmn/randoms": "^0.9.38",
    "@pkmn/sim": "^0.9.38"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  },
  "files": [
    "dist"
  ]
}
