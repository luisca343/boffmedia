{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest"
      ],
      "enabled": true,
      "timeout": 30000
    },
    "gitkraken": {
      "type": "local",
      "command": [
        "gk",
        "mcp"
      ],
      "enabled": true
    },
    "janus": {
      "type": "local",
      "command": [
        "/bin/bash",
        "-c",
        "source /home/luisca/.nvm/nvm.sh && exec janus mcp"
      ],
      "enabled": true,
      "timeout": 60000
    }
  },
  "permission": {
    "bash": {
      "pnpm --filter api test": "deny",
      "pnpm --filter api test ": "deny",
      "*": "allow"
    }
  }
}