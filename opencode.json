{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@warp-dot-dev/opencode-warp"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  },
  "permission": {
    "bash": {
      "pnpm --filter api test": "deny",
      "pnpm --filter api test ": "deny",
      "*": "allow"
    }
  }
}