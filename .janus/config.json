{
  "$schema": "./config.schema.json",
  "project": {
    "name": "boffmedia",
    "description": "Monorepo for Boffmedia (gaming tools platform) and SmartRotom (Pixelmon/Minecraft companion), with a shared NestJS API and Next.js client."
  },
  "verification": {
    "stages": [
      {
        "name": "lint",
        "command": "pnpm lint"
      },
      {
        "name": "type-check",
        "command": "pnpm type-check"
      }
    ]
  },
  "guardrails": {
    "ignoreFile": ".agentignore",
    "patterns": []
  },
  "git": {
    "branchPrefix": "janus/",
    "mirrors": [],
    "defaultBranch": "main"
  },
  "context": {
    "groups": [
      {
        "keywords": ["nestjs", "api", "controller", "service", "dto", "module", "guard", "interceptor"],
        "globs": ["apps/api/**/*.ts"]
      },
      {
        "keywords": ["boffmedia", "herramientas", "eventos", "ficus", "gaming", "tools"],
        "globs": ["apps/web/src/app/(boffmedia)/**/*.tsx", "apps/web/src/components/boffmedia/**/*.tsx", "apps/web/src/services/api/boffmedia/**/*.ts"]
      },
      {
        "keywords": ["smartrotom", "pixelmon", "minecraft", "pokedex", "rotom", "mcef"],
        "globs": ["apps/web/src/app/smartrotom/**/*.tsx", "apps/web/src/components/smartrotom/**/*.tsx", "apps/web/src/services/api/smartrotom/**/*.ts", "apps/web/src/services/mcef/**/*.ts"]
      },
      {
        "keywords": ["shared", "types", "openapi", "models", "generated"],
        "globs": ["packages/shared/src/**/*.ts"]
      },
      {
        "keywords": ["drizzle", "schema", "migration", "database", "mysql"],
        "globs": ["apps/api/src/_db/schema/**/*.ts", "apps/api/drizzle/**/*.ts", "apps/api/drizzle.config.ts"]
      },
      {
        "keywords": ["discord", "bot", "necord", "slash-command"],
        "globs": ["apps/api/src/discord/**/*.ts"]
      },
      {
        "keywords": ["zustand", "store", "state"],
        "globs": ["apps/web/src/stores/**/*.ts"]
      },
      {
        "keywords": ["playwright", "test", "e2e"],
        "globs": ["apps/web/tests/**/*.ts", "apps/web/playwright.config.ts"]
      },
      {
        "keywords": ["jest", "test", "unit", "spec"],
        "globs": ["apps/api/**/*.spec.ts", "apps/api/jest.config.ts"]
      }
    ],
    "alwaysInclude": [
      "AGENTS.md",
      "CONVENTIONS.md",
      "package.json",
      "pnpm-workspace.yaml"
    ],
    "maxFiles": 25
  },
  "structural": {
    "rules": [
      {
        "pattern": "apps/api/src/api/**/!(.module).ts",
        "kind": "new-nestjs-module",
        "adrRecommended": false
      },
      {
        "pattern": "apps/api/src/_db/schema/*.ts",
        "kind": "new-drizzle-schema",
        "adrRecommended": false
      },
      {
        "pattern": "packages/shared/src/**/*.ts",
        "kind": "shared-types-change",
        "adrRecommended": false
      },
      {
        "pattern": "apps/web/src/services/api/**/*.ts",
        "kind": "new-api-service",
        "adrRecommended": false
      },
      {
        "pattern": "apps/web/src/components/smartrotom/ui/*.tsx",
        "kind": "smartrotom-design-change",
        "adrRecommended": false
      },
      {
        "pattern": "apps/web/src/components/ui/primitives/*.tsx",
        "kind": "global-primitive-change",
        "adrRecommended": false
      }
    ]
  },
  "skills": {
    "enabled": [
      "*"
    ]
  },
  "memory": {
    "enabled": true,
    "autoSave": true,
    "reviewCycleDays": 30
  }
}
