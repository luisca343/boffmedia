{
  "$ref": "#/definitions/JanusConfig",
  "definitions": {
    "JanusConfig": {
      "type": "object",
      "properties": {
        "$schema": {
          "type": "string"
        },
        "project": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "stages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "cwd": {
                    "type": "string"
                  },
                  "env": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "default": 600000
                  },
                  "continueOnFailure": {
                    "type": "boolean",
                    "default": false
                  },
                  "appliesTo": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "name",
                  "command"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {
            "stages": []
          }
        },
        "guardrails": {
          "type": "object",
          "properties": {
            "ignoreFile": {
              "type": "string",
              "default": ".agentignore"
            },
            "patterns": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "git": {
          "type": "object",
          "properties": {
            "branchPrefix": {
              "type": "string",
              "default": "janus/"
            },
            "mirrors": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "defaultBranch": {
              "type": "string",
              "default": "main"
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "forge": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "gitlab"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "projectId": {
                  "type": "string"
                },
                "defaultBranch": {
                  "type": "string",
                  "default": "main"
                }
              },
              "required": [
                "provider",
                "url",
                "projectId"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "const": "github"
                },
                "repo": {
                  "type": "string",
                  "pattern": "^[^/]+\\/[^/]+$"
                },
                "defaultBranch": {
                  "type": "string",
                  "default": "main"
                }
              },
              "required": [
                "provider",
                "repo"
              ],
              "additionalProperties": false
            }
          ]
        },
        "sync": {
          "type": "object",
          "properties": {
            "bookstack": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "bookId": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "chapterPerSpec": {
                  "type": "boolean",
                  "default": true
                },
                "adrChapterId": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "tagPrefix": {
                  "type": "string",
                  "default": "janus"
                }
              },
              "required": [
                "url",
                "bookId"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "context": {
          "type": "object",
          "properties": {
            "groups": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "keywords": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  },
                  "globs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "keywords",
                  "globs"
                ],
                "additionalProperties": false
              },
              "default": []
            },
            "alwaysInclude": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "maxFiles": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 20
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "structural": {
          "type": "object",
          "properties": {
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "pattern": {
                    "type": "string"
                  },
                  "kind": {
                    "type": "string"
                  },
                  "adrRecommended": {
                    "type": "boolean",
                    "default": false
                  }
                },
                "required": [
                  "pattern",
                  "kind"
                ],
                "additionalProperties": false
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "skills": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": [
                "*"
              ]
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "memory": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "autoSave": {
              "type": "boolean",
              "default": true
            },
            "reviewCycleDays": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "default": 30
            }
          },
          "additionalProperties": false,
          "default": {}
        }
      },
      "required": [
        "project"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
