# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
# Set to "true" to generate a bundle-analyzer report on build
ANALYZE=

# ── Public — inlined into browser bundles at build time ──────────────
# Public base URL of the web app
NEXT_PUBLIC_URL=http://localhost:3000
# API base URL
NEXT_PUBLIC_API=http://localhost:34301
NEXT_PUBLIC_SOCKET_URL=http://localhost:34301
NEXT_PUBLIC_ROTOM_API_URL=
NEXT_PUBLIC_MC_WORLD=
# Pokémon Showdown iframe target — prefer an HTTPS host
NEXT_PUBLIC_SHOWDOWN_URL=http://148.251.3.244:8002/
NEXT_PUBLIC_TWITCH_CLIENT_ID=
# Origin serving the static asset tree, without a trailing slash. Empty = the
# assets share this app's origin, which is what `staticAsset` assumes; set it to
# move every asset URL to another host.
NEXT_PUBLIC_STATIC_URL=
# Un-hide SmartRotom stub apps for local/staff testing (comma-separated).
# Hiding is the default and lives in app/smartrotom/_config/hidden-apps.ts.
NEXT_PUBLIC_UNHIDE_APPS=

# ── Error tracking (Sentry SaaS) — inlined into browser bundles ──────
# Empty is the working default and means the SDK is never imported at all (see
# lib/sentry.ts). NEXT_PUBLIC_ because the browser needs it too: a DSN is a
# write-only ingest endpoint, not a secret, which is why Sentry publishes it in
# client bundles by design.
NEXT_PUBLIC_SENTRY_DSN=
# Overrides the environment tag; defaults to NODE_ENV. Set it when several deploys
# share a NODE_ENV ('staging' and 'production' are both 'production').
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Release tag. next.config.mjs fills this from apps/web/package.json when it is not
# set explicitly, so events always carry a version even unconfigured.
NEXT_PUBLIC_SENTRY_RELEASE=

# ── Auth (NextAuth) — server-side only ───────────────────────────────
# Encrypts the NextAuth session cookie. Its own value, NOT the API's JWT_SECRET —
# the two sign different things, and sharing them means one rotation silently
# breaks the other. Changing it logs everyone out.
#
#   generate:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   or:        openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord OAuth app (login + profile linking) — features stay inert until both are set
DISCORD_ID=
DISCORD_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional — only used to resolve the persona name/avatar when linking Steam
STEAM_API_KEY=

# ── Third-party APIs ─────────────────────────────────────────────────
# Server-side only — proxied via /api/youtube, never shipped to the browser
YOUTUBE_API_KEY=

# ── Testing (Playwright) ─────────────────────────────────────────────
# Defaults to https://ficuslab.es when unset
BASE_URL=
TEST_USERNAME=
TEST_PASSWORD=
