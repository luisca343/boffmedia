NODE_ENV=development  # any string is accepted; defaults to "development" if unset

# Public API endpoints (available in browser bundles)
NEXT_PUBLIC_API=http://localhost:34301
NEXT_PUBLIC_TERAS_API=http://localhost:34302
NEXT_PUBLIC_MC_WORLD=your-minecraft-world-name
NEXT_PUBLIC_SOCKET_URL=http://localhost:34301
NEXT_PUBLIC_URL=http://localhost:3000
NEXT_PUBLIC_ROTOM_API_URL=
NEXT_PUBLIC_TWITCH_CLIENT_ID=
NEXT_PUBLIC_TWITCH_CLIENT_SECRET=

# Server-side only — never exposed to browser bundles
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
