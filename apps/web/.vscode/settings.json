{
    "typescript.tsdk": "node_modules\\typescript\\lib",
    "files.exclude": {
        "node_modules": true,
    },
    "i18n-ally.localesPaths": ["./locales"], // Ensure this path is correct
    "i18n-ally.keystyle": "nested",
    "i18n-ally.enabledFrameworks": ["next-intl"], // Enable the framework you are using
    "i18n-ally.sourceLanguage": "es", // Set the source language
    "i18n-ally.displayLanguage": "es", // Set the display language
    "[javascript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[javascriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
}