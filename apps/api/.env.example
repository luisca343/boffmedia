NODE_ENV=development  # any string is accepted; defaults to "development" if unset

# MySQL connection
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=boffmedia
DB_PORT=3306

# Drizzle-kit migrations only
DATABASE_URL=mysql://your_db_user:your_db_password@localhost:3306/boffmedia

# Auth
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Minecraft
MC_WORLD=your-minecraft-world-name

# Wingull
WINGULL_API=http://localhost:8080
WINGULL_DB_NAME=wingull

# Discord / StreamElements
DISCORD_KEY=your-discord-bot-token
STREAMELEMENTS_KEY=

# AI (optional)
GEMINI_API_KEY=

# Browser / scraper (optional)
CHROME_PATH=
MANGA_BROWSER_WS_ENDPOINT=
MANGA_SCRAPER_PROXY=
MANGA_SCRAPER_PROXY_LIST_URL=

# Static files (optional)
PUBLIC_DIR=
