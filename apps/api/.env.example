# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=34301
# Public base URL of the web app — used to build reset/verify links
WEB_URL=http://localhost:3000
# Directory served as static files (optional)
PUBLIC_DIR=

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Wingull game-server database (read alongside the main DB)
WINGULL_DB_NAME=
# Used by drizzle-kit migrations only
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ── Auth ─────────────────────────────────────────────────────────────
# Min 32 characters
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to the standard callback route
GOOGLE_CALLBACK_URL=
# Public URL of the web app, used to build absolute links in Discord
# announcements. Optional — falls back to the production host.
NEXTAUTH_URL=

# ── Minecraft / game server ──────────────────────────────────────────
MC_WORLD=
# Wingull plugin HTTP API base URL
WINGULL_API=
# Keep false until the game server ships /takepokemon + /takeitems —
# see WigglypopCustodyService
WIGGLYPOP_ATOMIC_CUSTODY=false
# Shared secret the Minecraft plugin sends as `X-Server-Key` to authenticate
# server-to-server money/admin calls (GameOrUserAuthGuard). Optional in dev.
GAME_SERVER_SECRET=
# Money/admin route auth rollout. Keep false until the plugin ships
# `X-Server-Key`; flipping to true disables the legacy MC_WORLD tripwire and
# requires a user JWT (web) or the server key (game). See GameOrUserAuthGuard.
ENFORCE_MONEY_AUTH=false

# ── Discord / StreamElements ─────────────────────────────────────────
# DISCORD_KEY is the bot token; DISCORD_ID/DISCORD_SECRET are the OAuth
# application credentials (login + profile linking, read by the web app)
DISCORD_KEY=
DISCORD_ID=
DISCORD_SECRET=
STREAMELEMENTS_KEY=
# Webhook for tournament announcements. TOURNAMENTS_* wins if both set;
# announcements are silently disabled when neither is present.
TOURNAMENTS_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Twitch ───────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
# When unset, MailService logs emails to the console instead of sending
RESEND_API_KEY=
MAIL_FROM=BoffMedia <no-reply@boffmedia.com>

# ── Third-party APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=
# Pokémon Showdown battle-sim websocket. Optional — defaults to sim3.psim.us
SHOWDOWN_SERVER_URL=

# ── Browser / manga scraper (optional) ───────────────────────────────
CHROME_PATH=
MANGA_BROWSER_WS_ENDPOINT=
MANGA_SCRAPER_PROXY=
# URL returning a proxy list for the manga scraper
MANGA_SCRAPER_PROXY_LIST_URL=

# ── Testing (Playwright auth setup) ──────────────────────────────────
TEST_USERNAME=
TEST_PASSWORD=
