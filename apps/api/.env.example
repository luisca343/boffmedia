# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=34301
# Public base URL of the web app — used to build reset/verify links
WEB_URL=http://localhost:3000
# Directory served as static files (optional)
PUBLIC_DIR=

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Wingull game-server database (read alongside the main DB)
WINGULL_DB_NAME=
# Used by drizzle-kit migrations only
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ── Auth ─────────────────────────────────────────────────────────────
# Min 32 characters
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to the standard callback route
GOOGLE_CALLBACK_URL=
# Public URL of the web app, used to build absolute links in Discord
# announcements. Optional — falls back to the production host.
NEXTAUTH_URL=

# ── Minecraft / game server ──────────────────────────────────────────
MC_WORLD=
# Wingull plugin HTTP API base URL
WINGULL_API=
# Keep false until the game server ships /takepokemon + /takeitems —
# see WigglypopCustodyService
WIGGLYPOP_ATOMIC_CUSTODY=false
# ⚠️ TODO(prod + dev): generate ONE value and set it in BOTH places, or the mod
# cannot authenticate to this API at all.
#
#   generate:  openssl rand -base64 32
#   here:      TERAS_API_TOKEN=<value>
#   mod:       "apiToken": "<same value>"   in the teras server config JSON
#              (read by TerasConfig.load(); it defaults to "" — and HttpText only
#               sends `Authorization: Bearer` when it is NON-EMPTY, so a blank
#               token means the mod sends no credential at all)
#
# This is a real secret: server-side only, never shipped to a browser. It is what
# tells GameOrUserAuthGuard "this caller is the game server" (-> req.serverAuthed,
# ownership checks skipped). Not a JWT — the guard checks it BEFORE JWT parsing.
#
# Do NOT use MC_WORLD for this. That value is a world identifier, it is stored in
# rotom_users.world, and NEXT_PUBLIC_MC_WORLD ships inside the browser bundle —
# anyone can read it. Authenticating a spend endpoint with it would let a stranger
# destroy any player's rewards with one curl.
#
# Blank = fail-closed: /smartrotom/caja/claim 401s and the B1 money rollout stays
# blocked. Nothing else breaks.
TERAS_API_TOKEN=
# Money/admin route auth rollout. Keep false until the WEB sends its JWT on money
# calls; flipping to true disables the legacy MC_WORLD tripwire and requires a user
# JWT (web) or the mod's TERAS_API_TOKEN (game). Do not flip it before that token
# is set on both sides — you would lock the game server out. See GameOrUserAuthGuard.
ENFORCE_MONEY_AUTH=false

# ── Discord / StreamElements ─────────────────────────────────────────
# DISCORD_KEY is the bot token; DISCORD_ID/DISCORD_SECRET are the OAuth
# application credentials (login + profile linking, read by the web app)
DISCORD_KEY=
DISCORD_ID=
DISCORD_SECRET=
STREAMELEMENTS_KEY=
# Webhook for tournament announcements. TOURNAMENTS_* wins if both set;
# announcements are silently disabled when neither is present.
TOURNAMENTS_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Twitch ───────────────────────────────────────────────────────────
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
# When unset, MailService logs emails to the console instead of sending
RESEND_API_KEY=
MAIL_FROM=BoffMedia <no-reply@boffmedia.com>

# ── Third-party APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=
# Pokémon Showdown battle-sim websocket. Optional — defaults to sim3.psim.us
SHOWDOWN_SERVER_URL=

# ── Packs / launcher ─────────────────────────────────────────────────
# CurseForge API key — required by the mod catalog and the download proxy;
# without it those routes answer 503
CURSEFORGE_API_KEY=
# Where override blobs are stored. Defaults to ./data/pack-blobs, which under
# Docker is the container's WRITABLE LAYER and is deleted on every redeploy —
# taking the blobs of every published override pack with it, after which those
# packs fail to install with "falta subirlo". Point it at the bind mount.
# Prod: /app/laboon/pack-blobs
PACK_BLOB_DIR=
# Where the launcher's own release bundles are stored (§9 auto-update). Same
# reasoning and same mount as PACK_BLOB_DIR. Nothing is ever copied here by
# hand: POST /launcher/admin/releases creates the directory and writes the file.
# Prod: /app/laboon/launcher-releases
LAUNCHER_RELEASE_DIR=
# Absolute origin the updater feed writes into its `url` fields, no trailing
# slash. Unset, it is derived from x-forwarded-proto/host — correct in dev and
# behind a good proxy, silently wrong behind a bad one, and the failure then
# happens on the user's machine at install time, not here.
# dev/pre-producción: https://api.ficuslab.es · producción: https://api.boffmedia.es
LAUNCHER_UPDATE_BASE_URL=

# ── Browser / manga scraper (optional) ───────────────────────────────
CHROME_PATH=
MANGA_BROWSER_WS_ENDPOINT=
MANGA_SCRAPER_PROXY=
# URL returning a proxy list for the manga scraper
MANGA_SCRAPER_PROXY_LIST_URL=

# ── Testing (Playwright auth setup) ──────────────────────────────────
TEST_USERNAME=
TEST_PASSWORD=
