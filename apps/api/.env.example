# Source of truth for this file: apps/api/src/config/env.ts.
# Every key below either appears in that zod schema or is read directly through
# process.env / ConfigService (those are called out where they appear).
# A key shown WITH a value is that key's DEFAULT — delete the line and behaviour
# is unchanged. A key left blank is either required or an opt-in.
#
# Every secret below carries its own `generate:` line. The commands use node so
# they behave the same in PowerShell, Git Bash and CI; where an openssl form is
# given as well, the two are interchangeable. Generate a SEPARATE value per
# environment — never copy a dev secret into production.

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=34301
# WebSocket gateway port. Env-driven so it can move without a code change.
SOCKET_PORT=34304
# Public base URL of the web app — used to build reset/verify links.
# In production this MUST be the public origin: env.ts fails the boot when it is
# missing or points at localhost, rather than shipping localhost reset links.
WEB_URL=http://localhost:3000
# Public base URL of the asset tree, no trailing slash — the origin that
# config/asset-url.ts prefixes onto stored, relative asset paths. Unset = the URLs
# come out root-relative, which is right whenever API and assets share an origin.
PUBLIC_DIR=
# Filesystem root of the WRITABLE uploads store. Unset = <cwd>/var/uploads.
# Keep it on local disk: these files are read on ordinary page loads and the
# laboon mount is network storage.
UPLOADS_ROOT=
# Filesystem root of the READ-ONLY asset tree. Unset = <cwd>/public, the
# bind-mount path in both dev and the container. Set it only if the tree moved.
PUBLIC_ROOT=

# ── Database (MySQL) ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# The Teras mod's database, read alongside the main one. SEPARATE ON PURPOSE: the mod owns
# these tables and migrates them itself (teras_schema_version), while reset-database.js drops
# every table in DATABASE() and drizzle-kit push drops whatever is not in the drizzle schema.
# Sharing one database would put teras_plot_transaction — the starbank reconciliation ledger —
# one command away from deletion. Same host/user/password as above, different database.
WINGULL_DB_NAME=
# Used by drizzle-kit migrations only.
DATABASE_URL=mysql://user:password@localhost:3306/dbname
# NOT in the zod schema — read off ConfigService in drizzle.module.ts.
# Queries slower than this land in the slow-query histogram. "Slow" is
# deployment-specific: 200ms is alarming on a local socket and unremarkable
# across a region. Unset = 500.
SLOW_QUERY_MS=500

# ── Auth ─────────────────────────────────────────────────────────────
# Signs every access/refresh/desktop/ingame token. Min 32 characters; the command
# below gives 64. Changing it invalidates every session and every device code at
# once, so treat a rotation as a forced global logout.
#
#   generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   or:        openssl rand -base64 48
JWT_SECRET=
# AES-256-GCM key, EXACTLY 64 hex characters, for the few secrets that must be
# stored recoverably rather than hashed — today only the TOTP shared secrets
# behind admin 2FA. See _utils/crypto/secret-box.ts.
#
#   generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   or:        openssl rand -hex 32
#
# NOT `openssl rand -base64 32` — that is the command in the TERAS_API_TOKEN block
# below, and its output fails the 64-hex-character check at boot.
#
# Optional so dev and the test suite boot without it, but it FAILS CLOSED: with no
# key, enrolling a second factor returns AUTH_TWO_FACTOR_UNAVAILABLE ("no está
# disponible en este servidor") instead of storing the secret in the clear — so an
# admin on a box without the key cannot finish enrolment and, because 2FA is
# mandatory for admins, cannot finish logging in either.
#
# There is no key-rotation path yet. Changing this value after admins have
# enrolled makes every stored TOTP secret undecryptable and forces them all to
# re-enrol, so set it BEFORE the first enrolment.
SECRET_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional — defaults to the standard callback route.
GOOGLE_CALLBACK_URL=
# Public URL of the web app, used to build absolute links in Discord
# announcements and outbox emails. Optional — falls back to the production host.
NEXTAUTH_URL=

# ── Minecraft / game server ──────────────────────────────────────────
MC_WORLD=
# Wingull plugin HTTP API base URL.
WINGULL_API=
# ⚠️ TODO(prod + dev): generate ONE value and set it in BOTH places, or the mod
# cannot authenticate to this API at all.
#
#   generate:  openssl rand -base64 32
#   here:      TERAS_API_TOKEN=<value>
#   mod:       "apiToken": "<same value>"   in the teras server config JSON
#              (read by TerasConfig.load(); it defaults to "" — and HttpText only
#               sends `Authorization: Bearer` when it is NON-EMPTY, so a blank
#               token means the mod sends no credential at all)
#
# This is a real secret: server-side only, never shipped to a browser. It is what
# tells GameOrUserAuthGuard "this caller is the game server" (-> req.serverAuthed,
# ownership checks skipped). Not a JWT — the guard checks it BEFORE JWT parsing.
#
# Do NOT use MC_WORLD for this. That value is a world identifier, it is stored in
# rotom_users.world, and NEXT_PUBLIC_MC_WORLD ships inside the browser bundle —
# anyone can read it. Authenticating a spend endpoint with it would let a stranger
# destroy any player's rewards with one curl.
#
# Blank = fail-closed: /smartrotom/caja/claim 401s and the B1 money rollout stays
# blocked. Nothing else breaks.
TERAS_API_TOKEN=

# ── Wigglypop marketplace ────────────────────────────────────────────
# Keep false until the game server ships /takepokemon + /takeitems — both still
# 404, so flipping this on today fails every take. While it is off a sale only
# moves money (buyer → escrow → seller) and the two players hand the Pokémon over
# in-game themselves; the API never calls givePokemon, because without a matching
# take that would DUPLICATE the mon. See WigglypopCustodyService.
WIGGLYPOP_ATOMIC_CUSTODY=false
# How long an atomic order may sit mid-delivery before the saga sweeper calls it
# crashed. It MUST outlast the outbox's own retry ladder (1s + 5s + 30s + 5m + 1h
# ≈ 65 min), or the sweeper escalates orders the dispatcher is still legitimately
# retrying and a human gets paged for nothing.
WIGGLYPOP_SAGA_STALE_MINUTES=120

# ── Discord / StreamElements ─────────────────────────────────────────
# DISCORD_KEY is the bot token; DISCORD_ID/DISCORD_SECRET are the OAuth
# application credentials (login + profile linking). The latter two are validated
# by the WEB app's schema, not this one — they live here because both apps read
# the same .env.
#
# The bot boots IN-PROCESS with the HTTP server. With no token the whole Discord
# subtree — the gateway client and all 19 command providers — is never registered
# and the API serves HTTP and websockets as usual. A missing token degrades; it
# does not crash.
DISCORD_KEY=
DISCORD_ID=
DISCORD_SECRET=
# Explicit kill switch, independent of the token, for when the bot IS the thing
# misbehaving and you want it off without hunting down the secret.
DISCORD_BOT_ENABLED=true
STREAMELEMENTS_KEY=
# Webhook for tournament announcements. TOURNAMENTS_* wins if both are set;
# announcements are silently disabled when neither is present.
TOURNAMENTS_DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# ── Twitch ───────────────────────────────────────────────────────────
# NOT in the zod schema — read through ConfigService in twitch-api.service.ts
# (and separately by the web app's own schema).
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────
# When unset, MailService logs emails to the console instead of sending.
RESEND_API_KEY=
# boffmedia.es is the domain actually verified in Resend, and the one the rest of
# the app uses (production cookies are pinned to .boffmedia.es). The old .com
# value made Resend refuse every send with a 403, which MailService logs and
# swallows: the outbox then marked the row delivered and no email existed anywhere.
MAIL_FROM=BoffMedia <no-reply@boffmedia.es>
# HMAC-SHA256 secret for verifying Resend's bounce/complaint webhooks.
# Unset = webhooks cannot be verified and are rejected as hostile.
RESEND_WEBHOOK_SECRET=

# ── Third-party APIs ─────────────────────────────────────────────────
GEMINI_API_KEY=
# Pokémon Showdown battle-sim websocket.
SHOWDOWN_SERVER_URL=wss://sim3.psim.us/showdown/websocket
# Per-user daily token budget for FicusAI (LLM usage), in tokens. 0 = unlimited.
FICUSAI_DAILY_TOKEN_BUDGET=100000

# ── Error tracking (Sentry SaaS) ─────────────────────────────────────
# Unset means the SDK is never even require()d, so dev, CI and the test suite
# carry no Sentry at all and print nothing about it.
SENTRY_DSN=
# Overrides the environment tag; defaults to NODE_ENV. Set it when several deploys
# share a NODE_ENV ('staging' and 'production' are both 'production').
SENTRY_ENVIRONMENT=
# Release tag. Unset = api@<version in apps/api/package.json>, which only tells two
# deploys apart if that version is bumped; set it to the commit sha in CI.
SENTRY_RELEASE=
# Performance tracing, off by default: the API already reports latency through
# Prometheus, and a span per request is the expensive half of Sentry. 0..1.
SENTRY_TRACES_SAMPLE_RATE=0

# ── Packs / desktop app ─────────────────────────────────────────────────
# CurseForge API key — required by the mod catalog and the download proxy; without
# it those routes answer 503. The key never reaches the launcher: since
# 16 July 2026 edge.forgecdn.net 401s without an x-api-key header, and an embedded
# key is an extracted key, so every CF byte is proxied by us.
CURSEFORGE_API_KEY=
# Where override blobs are stored, content-addressed by sha512. Deliberately
# OUTSIDE PUBLIC_DIR: overrides are gated by the pack ACL, and anything under the
# static root would be world-readable by URL.
# Local/WSL: ./laboon/pack-blobs (created by `pnpm setup`)
# Docker production: the same value resolves to /app/laboon/pack-blobs
# CURRENTLY INERT: both blob stores resolve through laboonPath() (cwd + /laboon) so
# uploads work with zero env setup, and setting this changes nothing until the TEMP
# note in config/paths.ts is unwound. Kept because deploy envs already set it.
PACK_BLOB_DIR=./laboon/pack-blobs
# Where the desktop app's own release bundles are stored (§9 auto-update). Same
# reasoning, same mount and the same INERT caveat as PACK_BLOB_DIR. Nothing is ever
# copied here by hand: POST /desktop/admin/releases creates the directory and
# writes the file.
DESKTOP_RELEASE_DIR=./laboon/desktop-releases
# Absolute origin the updater feed writes into its `url` fields, no trailing slash.
# Tauri fetches that URL from a separate process, so a relative path is useless.
# Unset, it is derived from x-forwarded-proto/host — correct in dev and behind a
# good proxy, silently wrong behind a bad one, and the failure then happens on the
# user's machine at install time, not here.
# dev/pre-producción: https://api.ficuslab.es · producción: https://api.boffmedia.es
DESKTOP_UPDATE_BASE_URL=

# ── Upload limits ────────────────────────────────────────────────────
# Maximum image width/height in pixels — the decompression-bomb cap. 8000×8000 is
# safe for sharp on standard hardware.
MAX_IMAGE_WIDTH=8000
MAX_IMAGE_HEIGHT=8000
# Per-user daily blob upload quota in MB. 0 = unlimited. Billed against the same
# ledger the web /upload routes use, so one surface cannot spend the other's budget.
UPLOAD_DAILY_QUOTA_MB=5120
# Refuse blob uploads once free disk space drops below this, in MB.
UPLOAD_MIN_FREE_SPACE_MB=10240

# ── GDPR data export ─────────────────────────────────────────────────
# Filesystem root of the export archives. Unset = <cwd>/var/exports. Deliberately
# NOT under UPLOADS_ROOT: that tree is served statically at /uploads, and an export
# is the single most concentrated pile of one person's data the system can produce.
# It is only ever read back through an authenticated route.
DATA_EXPORT_ROOT=
# How long a built export stays downloadable.
DATA_EXPORT_TTL_DAYS=7
# Minimum gap between two export requests from the same account. Building one reads
# ~50 tables, so this is the rate limit that matters — the HTTP throttler only stops
# a burst, not one request an hour forever.
DATA_EXPORT_COOLDOWN_HOURS=24

# ── Data retention (daily sweep) ─────────────────────────────────────
# Set any to 0 to disable that sweep. Days for notifications/invites, months for
# audits. Deletes are bounded by LIMIT and loop until fewer rows match, so a first
# run against a large table will not lock it for minutes or blow the binlog.
RETENTION_NOTIFICATIONS_DAYS=90
RETENTION_AUDIT_MONTHS=12
RETENTION_GOBIERNO_AUDIT_MONTHS=12
RETENTION_EVENT_INVITES_GRACE_DAYS=30
# Most recent N versions kept per note.
RETENTION_NOTE_VERSIONS_KEEP=20
# DELIVERED rows only; failed ones are kept.
RETENTION_OUTBOX_DAYS=30
# How long a SOFT-DELETED account is kept before the sweep hard-deletes it and
# everything hanging off it. The row is already scrubbed of every PII field the
# moment the user asks, so this is not "we keep your data for a month" — it is how
# long the tombstone survives, the standard grace period for an accidental or
# coerced deletion. 0 disables erasure.
RETENTION_DELETED_USER_DAYS=30

# ── Randomizer (FVX jar runner) ──────────────────────────────────────
RANDOMIZER_JAR=
# Do not assume the java on PATH is the right one — point this at a JDK 21.
RANDOMIZER_JAVA=java
RANDOMIZER_SCRATCH_DIR=
RANDOMIZER_MAX_CONCURRENCY=2
RANDOMIZER_TIMEOUT_MS=180000
# Settings shim (JSON ↔ .rnqs converter)
RANDOMIZER_SHIM_JAR=
RANDOMIZER_SHIM_MAX_CONCURRENCY=2
RANDOMIZER_SHIM_TIMEOUT_MS=30000

# ── Pokémon Showdown log scraper ─────────────────────────────────────
# Google Sheets API key file path (relative to cwd, or absolute).
POKEMON_LOG_SERVICE_KEY_FILE=
# The Showdown username to treat as the local player in battle logs.
POKEMON_LOG_LOCAL_PLAYER=

# ── Browser / manga scraper (optional) ───────────────────────────────
CHROME_PATH=
MANGA_BROWSER_WS_ENDPOINT=
MANGA_SCRAPER_PROXY=
# URL returning a proxy list for the manga scraper.
MANGA_SCRAPER_PROXY_LIST_URL=

# ── Seeding (pnpm seed:system / seed:dev) ────────────────────────────
# NOT in the zod schema — read straight off process.env by the seed scripts.
# REQUIRED to seed, min 12 characters, and deliberately without a default: this is
# the only script that creates an administrator, so a literal fallback would put a
# live site's admin credentials in the repository. The seed throws without it.
# This becomes a REAL LOGIN for the `admin` account, so generate it rather than
# typing one, and store it wherever you keep the rest of your credentials — the
# seed hashes it with bcrypt and never prints it back.
#
#   generate:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
SEED_ADMIN_PASSWORD=
# Optional — defaults to admin@boffmedia.es.
SEED_ADMIN_EMAIL=

# ── Testing (Playwright auth setup) ──────────────────────────────────
# Read by apps/web/tests/auth.setup.ts. Unset = the .auth.spec.ts suites skip.
TEST_USERNAME=
TEST_PASSWORD=

# D15 — signs pack manifests served at /packs/launcher/packs/:id/manifest.signed.
# ed25519 PRIVATE key, base64 PKCS#8 DER. Generate one with:
#   node scripts/generate-pack-signing-key.mjs
# Optional: unset means that route answers 503 and nothing is signed. It never
# serves an unsigned body from the signed route. The launcher does not verify
# yet — the server signs for a full release cycle first, because a client that
# required a signature before the server produced one would brick every install
# in the field. The public half is served at GET /packs/launcher/manifest-key.
PACK_SIGNING_PRIVATE_KEY=

# A1 — the Discord guild every slash command is registered to. Defaulted in the
# schema to the production server, so leaving this unset keeps today's behaviour.
# Set it on a staging box: it was a literal compiled into seven source files, so
# a staging bot could only ever answer in the production guild.
DISCORD_GUILD_ID=

# A1 — false in the API container once the bot runs as its own process
# (dist/discord-main.js from the same image). True, or unset, keeps the bot
# in-process with the HTTP server, which is what it did before the split and
# what a deployment that has not been split yet still does. Do not leave BOTH
# containers with it true: two gateway clients on one token means Discord hands
# each interaction to one of them at random.
DISCORD_BOT_ENABLED=
