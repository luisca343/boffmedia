{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "dev": "cross-env NODE_OPTIONS=--max-old-space-size=2560 nest start --watch",
    "dev:win": "set \"NODE_OPTIONS=--max-old-space-size=2560\" && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node --max-old-space-size=4096 dist/main",
    "lint": "cross-env NODE_OPTIONS=--max-old-space-size=3072 eslint -c .eslintrc.memory-safe.js \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "lint:safe": "node ../../scripts/memory-check.js && NODE_OPTIONS='--max-old-space-size=2048' eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:fast": "cross-env NODE_OPTIONS=--max-old-space-size=2048 eslint -c .eslintrc.memory-safe.js src/**/*.ts --fix",
    "lint:src": "cross-env NODE_OPTIONS=--max-old-space-size=2048 eslint src/**/*.ts --fix",
    "lint:staged": "cross-env NODE_OPTIONS=--max-old-space-size=2048 eslint --fix",
    "type-check": "cross-env NODE_OPTIONS=--max-old-space-size=2048 tsc --noEmit --skipLibCheck",
    "test": "cross-env NODE_OPTIONS=--max-old-space-size=6144 jest --runInBand",
    "test:serial": "cross-env NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand",
    "test:handles": "cross-env NODE_OPTIONS=--max-old-space-size=4096 jest --runInBand --detectOpenHandles",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 jest --watch --maxWorkers=1",
    "test:cov": "cross-env NODE_OPTIONS=--max-old-space-size=4096 jest --coverage --runInBand",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "cross-env NODE_OPTIONS=--max-old-space-size=2048 jest --config ./test/jest-e2e.json --maxWorkers=1",
    "seed:system": "node ../../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/seed/system.ts",
    "seed:dev": "node ../../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/seed/dev.ts",
    "seed:house-accounts": "node ../../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/seed/house-accounts.ts",
    "seed:sql": "node ../../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/seed/generate-sql.ts",
    "check:seed-sql": "node ../../node_modules/ts-node/dist/bin.js -r tsconfig-paths/register src/seed/generate-sql.ts --check",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "push": "drizzle-kit push",
    "generate-api": "openapi --input http://localhost:34301/api-json --output ./src/generated/api --client axios",
    "generate:models": "openapi --input http://localhost:34301/api-json --output ./src/generated --exportModels true --exportServices false --exportCore false",
    "generate:shared": "openapi --input http://localhost:34301/api-json --output ../../packages/shared/src --exportModels true --exportServices false --exportCore false",
    "fix-pnpm": "powershell -ExecutionPolicy Bypass -File ./fix-pnpm.ps1",
    "convert-mod": "node ../../node_modules/ts-node/dist/bin.js -P scripts/convert-showdown-mod/tsconfig.json scripts/convert-showdown-mod/index.ts"
  },
  "dependencies": {
    "@boffmedia/asset-paths": "workspace:*",
    "@boffmedia/pack-schema": "workspace:*",
    "@discordjs/builders": "^1.14.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.13.0",
    "@google/generative-ai": "^0.24.1",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/schedule": "^6.0.0",
    "@nestjs/serve-static": "^5.0.3",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.6",
    "@noble/ciphers": "^2.2.0",
    "@pkmn/client": "^0.7.0",
    "@pkmn/data": "^0.10.7",
    "@pkmn/img": "^0.2.40",
    "@pkmn/login": "^0.2.0",
    "@pkmn/protocol": "^0.7.0",
    "@pkmn/randoms": "^0.9.38",
    "@pkmn/sim": "^0.9.38",
    "@pkmn/view": "^0.7.0",
    "@scalar/nestjs-api-reference": "^0.5.12",
    "@smogon/calc": "^0.10.0",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "abort-controller": "^3.0.0",
    "adm-zip": "^0.5.17",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cron": "^4.4.0",
    "discord.js": "^14.21.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.4",
    "drizzle-orm": "^0.44.4",
    "express": "^5.2.1",
    "fuse.js": "^7.1.0",
    "googleapis": "^155.0.1",
    "helmet": "^8.2.0",
    "libsodium-wrappers": "^0.7.15",
    "multer": "^2.0.2",
    "mysql2": "^3.14.3",
    "necord": "^6.9.1",
    "nestjs-i18n": "^10.5.1",
    "nestjs-pino": "^4.6.1",
    "openai": "^5.12.2",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "playwright": "^1.50.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "ws": "^8.20.0",
    "xml2js": "^0.6.2",
    "youtube-transcript": "^1.2.1",
    "youtubei.js": "^16.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/adm-zip": "^0.5.8",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^30.0.5",
    "openapi-typescript-codegen": "^0.29.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "standard": "^17.1.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2"
  }
}
