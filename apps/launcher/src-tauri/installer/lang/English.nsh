; English installer copy. See installer/lang/Spanish.nsh for the notes that
; apply to both files — most importantly that a custom language file REPLACES
; Tauri's, so every LangString installer.nsi references has to be here.

; --- Wizard pages (referenced from installer/hooks.nsh) ---
LangString boffWelcomeTitle ${LANG_ENGLISH} "Install ${PRODUCTNAME}"
LangString boffWelcomeText ${LANG_ENGLISH} "This wizard will install ${PRODUCTNAME} ${VERSION} on your computer.$\r$\n$\r$\nThe launcher downloads, updates and starts the Boffmedia packs for you — no need to install Java or Forge yourself.$\r$\n$\r$\nClick Next to continue."
LangString boffDirText ${LANG_ENGLISH} "The launcher will be installed in the folder below. Only the program goes here: your worlds, mods and instances live elsewhere in your user folder and are not removed when you uninstall."
LangString boffFinishTitle ${LANG_ENGLISH} "${PRODUCTNAME} is ready"
LangString boffFinishText ${LANG_ENGLISH} "You can now open the launcher and sign in with your Microsoft account.$\r$\n$\r$\nIt keeps itself up to date: when a new version ships, the launcher will tell you."
LangString boffRunApp ${LANG_ENGLISH} "Open ${PRODUCTNAME} now"
LangString boffFinishLink ${LANG_ENGLISH} "Visit boffmedia.es"
LangString boffAbortWarning ${LANG_ENGLISH} "Are you sure you want to quit the ${PRODUCTNAME} installer?"
LangString boffUnAbortWarning ${LANG_ENGLISH} "Are you sure you want to cancel uninstalling ${PRODUCTNAME}?"

; --- Standard MUI page copy worth making specific ---
LangString MUI_TEXT_DIRECTORY_TITLE ${LANG_ENGLISH} "Install location"
LangString MUI_TEXT_DIRECTORY_SUBTITLE ${LANG_ENGLISH} "Choose where ${PRODUCTNAME} will be installed."
LangString MUI_TEXT_INSTALLING_TITLE ${LANG_ENGLISH} "Installing"
LangString MUI_TEXT_INSTALLING_SUBTITLE ${LANG_ENGLISH} "Please wait while ${PRODUCTNAME} is installed."
LangString MUI_TEXT_FINISH_TITLE ${LANG_ENGLISH} "Installation complete"
LangString MUI_TEXT_FINISH_SUBTITLE ${LANG_ENGLISH} "${PRODUCTNAME} was installed successfully."
LangString MUI_UNTEXT_CONFIRM_TITLE ${LANG_ENGLISH} "Uninstall ${PRODUCTNAME}"
LangString MUI_UNTEXT_CONFIRM_SUBTITLE ${LANG_ENGLISH} "The launcher will be removed from your computer."
LangString MUI_UNTEXT_UNINSTALLING_TITLE ${LANG_ENGLISH} "Uninstalling"
LangString MUI_UNTEXT_UNINSTALLING_SUBTITLE ${LANG_ENGLISH} "Please wait while ${PRODUCTNAME} is removed."

; --- Tauri's 27. Mandatory: installer.nsi always references them. ---
LangString addOrReinstall ${LANG_ENGLISH} "Add/Reinstall components"
LangString alreadyInstalled ${LANG_ENGLISH} "Already installed"
LangString alreadyInstalledLong ${LANG_ENGLISH} "${PRODUCTNAME} ${VERSION} is already installed. Choose what you want to do and click Next."
LangString appRunning ${LANG_ENGLISH} "${PRODUCTNAME} is running. Close it and try again."
LangString appRunningOkKill ${LANG_ENGLISH} "${PRODUCTNAME} is running.$\nClick OK to close it and continue."
LangString chooseMaintenanceOption ${LANG_ENGLISH} "Choose the operation you want to perform."
LangString choowHowToInstall ${LANG_ENGLISH} "Choose how you want to install ${PRODUCTNAME}."
LangString createDesktop ${LANG_ENGLISH} "Create a desktop shortcut"
LangString deleteAppData ${LANG_ENGLISH} "Also delete your data: instances, worlds, mods and signed-in session"
LangString dontUninstall ${LANG_ENGLISH} "Do not uninstall"
LangString dontUninstallDowngrade ${LANG_ENGLISH} "Do not uninstall (this installer cannot downgrade without uninstalling first)"
LangString failedToKillApp ${LANG_ENGLISH} "Could not close ${PRODUCTNAME}. Close it manually and try again."
LangString installingWebview2 ${LANG_ENGLISH} "Installing WebView2..."
LangString newerVersionInstalled ${LANG_ENGLISH} "A newer version of ${PRODUCTNAME} is already installed. Installing an older one is not recommended; if you really want to, uninstall the current version first. Choose what you want to do and click Next."
LangString older ${LANG_ENGLISH} "older"
LangString olderOrUnknownVersionInstalled ${LANG_ENGLISH} "An $R4 version of ${PRODUCTNAME} is installed on your system. It is best to uninstall it before continuing. Choose what you want to do and click Next."
LangString silentDowngrades ${LANG_ENGLISH} "This installer cannot downgrade silently. Use the graphical installer instead.$\n"
LangString unableToUninstall ${LANG_ENGLISH} "Unable to uninstall."
LangString uninstallApp ${LANG_ENGLISH} "Uninstall ${PRODUCTNAME}"
LangString uninstallBeforeInstalling ${LANG_ENGLISH} "Uninstall before installing"
LangString unknown ${LANG_ENGLISH} "unknown"
LangString webview2AbortError ${LANG_ENGLISH} "WebView2 could not be installed, and the launcher does not run without it. Try running the installer again."
LangString webview2DownloadError ${LANG_ENGLISH} "Error downloading WebView2: $0"
LangString webview2DownloadSuccess ${LANG_ENGLISH} "WebView2 downloaded."
LangString webview2Downloading ${LANG_ENGLISH} "Downloading WebView2..."
LangString webview2InstallError ${LANG_ENGLISH} "Installing WebView2 failed with exit code $1."
LangString webview2InstallSuccess ${LANG_ENGLISH} "WebView2 installed."
