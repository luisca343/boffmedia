# Boff Launcher — plantilla de entorno.
#
# OJO, esto NO se carga solo. A diferencia de apps/api y apps/web, aquí no hay
# nada que lea un .env: las variables las consume `cargo` (option_env!/env::var)
# y el CLI de Tauri, que heredan el entorno del shell, no un archivo. Vite sólo
# carga .env para el renderer y sólo expone los prefijos VITE_ y TAURI_ENV_
# (ver envPrefix en vite.config.ts), así que ninguna de estas llegaría a Rust
# por esa vía.
#
# Para usarlo:
#   cp .env.example .env      # .env está en .gitignore
#   set -a; source .env; set +a
#   pnpm build            # dev/ficuslab · pnpm build:prod para producción
#
# En CI son secrets del repositorio, no un archivo.

# ── A qué API apunta el launcher ─────────────────────────────────────
# Vale para los packs y para el updater. En tiempo de ejecución gana sobre el
# valor compilado. El perfil de build (pnpm build / build:prod) ya lo pone;
# esto sólo hace falta para un tercer entorno puntual.
BOFF_API_URL=

# ── Firma del updater (sólo para construir una release) ──────────────
# La clave minisign privada, el CONTENIDO del archivo, no la ruta (para la ruta
# existe TAURI_SIGNING_PRIVATE_KEY_PATH). Vive en
# ~/.boff-launcher/boff-launcher-updater.key y NO se guarda aquí.
# Sin ella, `tauri build` no genera los .sig y no hay nada que subir.
TAURI_SIGNING_PRIVATE_KEY=
# La contraseña de esa clave. Si falta o es incorrecta, el build se queda
# esperando un prompt que en CI no contesta nadie.
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# ── Subir la release a la API (paso 4.3 de docs/RELEASING.md) ────────
# Credenciales del usuario de servicio con rol BOFF_ADMIN. Se guardan usuario
# y contraseña, NO un token ya emitido: el access_token dura 1 h, así que se
# pide uno nuevo en cada publicación (POST /auth/login → data.access_token) y
# no hay nada que caduque en el peor momento. Ver RELEASING.md §3.2 para
# crear el usuario y concederle el rol.
BOFF_ADMIN_USERNAME=
BOFF_ADMIN_PASSWORD=

# ── Desarrollo ───────────────────────────────────────────────────────
# Sólo para probar en un móvil o en otra máquina de la red: la IP en la que
# Vite escucha durante `tauri dev`.
TAURI_DEV_HOST=
