{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run cloc analysis",
      "type": "shell",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": [],
      "windows": {
        "command": "powershell -ExecutionPolicy Bypass -File \"${workspaceFolder}\\scripts\\run-cloc.ps1\""
      },
      "linux": {
        "command": "${workspaceFolder}/scripts/run-cloc.sh"
      },
      "osx": {
        "command": "${workspaceFolder}/scripts/run-cloc.sh"
      }
    }
  ]
}
