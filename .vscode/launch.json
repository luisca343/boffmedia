{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "🚀 Start Dev Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": ["start", "--watch"],
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      },
      "runtimeArgs": ["--preserve-symlinks"],
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "🐛 Debug Dev Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@nestjs/cli/bin/nest.js",
      "args": ["start", "--debug", "--watch"],
      "console": "integratedTerminal",
      "restart": true,
      "env": {
        "NODE_ENV": "development"
      },
      "runtimeArgs": ["--preserve-symlinks"],
      "skipFiles": ["<node_internals>/**"],
      "port": 9229
    },
    {
      "name": "🗄️ Drizzle Generate",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/drizzle-kit/bin.cjs",
      "args": ["generate"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "🔄 Drizzle Migrate",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/drizzle-kit/bin.cjs",
      "args": ["migrate"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "📤 Drizzle Push",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/drizzle-kit/bin.cjs",
      "args": ["push"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "🏭 Generate API Models",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/openapi-typescript-codegen/bin/index.js",
      "args": [
        "--input", "http://localhost:34301/api-json",
        "--output", "./src/generated",
        "--exportModels", "true",
        "--exportServices", "false",
        "--exportCore", "false"
      ],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "env": {
        "NODE_ENV": "development"
      }
    }
  ],
  "compounds": [
    {
      "name": "🚀 Start Dev + Generate Models",
      "configurations": ["🚀 Start Dev Server", "🏭 Generate API Models"],
      "stopAll": true
    }
  ]
}