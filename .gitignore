node_modules/
.env
.env.local
.env*.local
dist/
.next/
*.log
.DS_Store

# Per-app lockfiles — root pnpm-lock.yaml is authoritative
apps/*/pnpm-lock.yaml
apps/*/package-lock.json

# Google service account credentials — mount at runtime, never commit
apps/api/*.json
!apps/api/package.json
!apps/api/nest-cli.json
!apps/api/tsconfig.spec.json

/public/
apps/*/public/
laboon/

# API runtime cache (imageCache.json etc.) — regenerable, never commit
apps/api/var/

docs/handoffs/**

.janus/memory/
.env.janus

docs/**

# VGC training data (too large for git)
*.parquet
docs/vgc_data/

# ML training artifacts
training/.venv/
training/__pycache__/
training/configs/
models/
*.pyc
*.pyo
__pycache__/

.agents
.horus/
.claude