* text=auto eol=lf

# Never commit CRLF in scripts/config used by Linux tooling.
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.env text eol=lf
*.env.* text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf

# Windows-native scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
