{
  "name": "boffmedia",
  "private": true,
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "setup": "node scripts/setup-junctions.js",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "concurrently -n \"C,S\" \"pnpm dev:web\" \"pnpm dev:api\"",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "generate:shared": "pnpm --filter api generate:shared",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@pkmn/client": "^0.7.0",
      "@pkmn/data": "^0.10.7",
      "@pkmn/dex": "^0.9.38",
      "@pkmn/img": "^0.2.40",
      "@pkmn/login": "^0.2.0",
      "@pkmn/protocol": "^0.7.0",
      "@pkmn/randoms": "^0.9.38",
      "@pkmn/sim": "^0.9.38",
      "@pkmn/view": "^0.7.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "bufferutil",
      "core-js",
      "es5-ext",
      "esbuild",
      "necord",
      "next-translate-plugin",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
