{
  "name": "boffmedia",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup-junctions.js",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev": "concurrently -n \"C,S\" \"pnpm dev:web\" \"pnpm dev:api\"",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "generate:shared": "pnpm --filter api generate:shared",
    "lint": "node scripts/lint-sequential.js && node scripts/check-v3-conventions.mjs && node scripts/check-layering.mjs && node scripts/check-i18n.mjs",
    "lint:parallel": "pnpm -r lint",
    "check:v3": "node scripts/check-v3-conventions.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "type-check": "node scripts/typecheck-sequential.js",
    "type-check:parallel": "pnpm -r type-check",
    "memory-check": "node scripts/memory-check.js",
    "generate:i18n": "node scripts/generate-i18n-manifest.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5.0.0"
  },
  "pnpm": {
    "overrides": {
      "@pkmn/client": "^0.7.0",
      "@pkmn/data": "^0.10.7",
      "@pkmn/dex": "^0.9.38",
      "@pkmn/img": "^0.2.40",
      "@pkmn/login": "^0.2.0",
      "@pkmn/protocol": "^0.7.0",
      "@pkmn/randoms": "^0.9.38",
      "@pkmn/sim": "^0.9.38",
      "@pkmn/view": "^0.7.0"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@scarf/scarf",
      "@swc/core",
      "bcrypt",
      "bufferutil",
      "core-js",
      "es5-ext",
      "esbuild",
      "necord",
      "next-translate-plugin",
      "protobufjs",
      "sharp",
      "unrs-resolver",
      "utf-8-validate"
    ]
  }
}
