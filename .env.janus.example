# janus secrets — copy to .env.janus and fill in.
# .env.janus is gitignored; this .example file is safe to commit.
#
# Lookup order (highest precedence first):
#   1. your shell environment
#   2. this project's .env.janus (per-project tokens / overrides)
#   3. global ~/.config/janus/.env  ($XDG_CONFIG_HOME/janus/.env)
# Each layer only fills variables still unset, so the more specific one wins.
# Tip: put shared tokens (same BookStack instance / git account everywhere) in
# the global file once, and leave this per-project file empty.

# ── BookStack sync (janus sync ...) ──────────────────────────────
# Create an API token under your BookStack profile → API Tokens.
# BOOKSTACK_TOKEN=
# BOOKSTACK_SECRET=

# ── Forge: GitLab (config.forge.provider = "gitlab") ─────────────
# GITLAB_TOKEN=

# ── Forge: GitHub (config.forge.provider = "github") ─────────────
# GITHUB_TOKEN=
